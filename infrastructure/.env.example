POSTGRES_HOST_PORT=15432   # PostgreSQL, for local database tools
GATEWAY_HOST_PORT=8080     # API gateway, the single entry point to the backend

# --- Database -------------------------------------------------------------------------------
POSTGRES_USER=skillbridge
# Required. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=your_postgres_password_here

# --- auth-service --------------------------------------------------------------------------
# Required, at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your_jwt_secret_at_least_32_characters_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

SHARED_SKILL_KNOWLEDGE_PORT=8005

# --- RAG & AI Microservices (Learning & Interview) ----------------------------
LEARNING_SERVICE_PORT=8001
INTERVIEW_SERVICE_PORT=8002
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
EMBEDDING_PROVIDER=gemini

# Realistic human interviewer (HeyGen LiveAvatar)
LIVEAVATAR_API_KEY=your_heygen_liveavatar_key_here
LIVEAVATAR_SANDBOX=true
